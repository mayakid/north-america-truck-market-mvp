MODEL_ARTIFACT_PATH=artifacts/ranker.joblib
FEATURE_SNAPSHOT_PATH=artifacts/feature_snapshot.parquet
RAG_WORKING_DIR=rag_storage
MIN_HISTORY_MONTHS=12
VALIDATION_MONTHS=6
TEST_MONTHS=12

